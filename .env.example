TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

USDA_API_KEY=

# Path to the file downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json
# Written by the OAuth flow on first authorisation
GOOGLE_TOKEN_FILE=token.json

# The Racing API — free tier covers today/tomorrow race entries (racecards/free)
# Sign up at theracingapi.com — credentials from your account dashboard
RACING_API_USERNAME=
RACING_API_PASSWORD=

# Fantasy Premier League — neither ID is a secret, both come from
# fantasy.premierleague.com (your team ID from the URL, league ID from
# leagues-classic/{id}/standings)
FPL_ENABLED=false
FPL_TEAM_ID=
FPL_LEAGUE_ID=
